#!/usr/bin/env bash
#
# enforce-teammate-lanes — PreToolUse hook
#
# Enforces per-role tool lanes for spawned teammates to prevent rogue writes.
# This is the root-cause fix for teammates (e.g. Librarian) escaping their lane
# by directly writing to the repo source tree or running git commits there.
#
# Lane table:
#   Librarian → Write/Edit only under $BRAINS_VAULT_DIR; git only on vault repo
#   Critic    → no repo Write/Edit/git-commit/push; read-only repo access
#   Scout     → no repo Write/Edit/git-commit/push; read-only repo access
#   Builder   → full repo access (no lane restriction)
#   Neal/lead → governed by enforce-neal-allowlist, not this hook
#
# Fail-CLOSED design:
#   - If VAULT_DIR cannot be resolved, Librarian writes are DENIED (not allowed).
#   - If agent_type/role is empty, the hook defaults to DENY for restricted tools
#     rather than falling through to allow-all.
#
# Gate: only active when state/active.* exists. No-ops outside active sessions.
# Detection: reuses the in-subagent.* marker pattern from enforce-neal-allowlist.
#   agent_type comes from the hook stdin (SubagentStart writes it).
#
# Denial: hard deny with a clear systemMessage naming the violated lane.

set -euo pipefail

# ── Gate: active session only ──────────────────────────────────────────
if ! ls ".brains_in_a_hat/state/active."* >/dev/null 2>&1; then
  exit 0
fi

# ── Gate: only fire inside a subagent ─────────────────────────────────
# If no in-subagent.* marker exists, we are in the parent (Neal) session —
# enforce-neal-allowlist handles that. Exit here to avoid double-enforcement.
if ! ls ".brains_in_a_hat/state/in-subagent."* >/dev/null 2>&1; then
  exit 0
fi

# ── Read hook input ────────────────────────────────────────────────────
INPUT=$(cat)
TOOL_NAME=$(printf '%s' "$INPUT" | jq -r '.tool_name // empty' 2>/dev/null) || TOOL_NAME=""
TOOL_INPUT=$(printf '%s' "$INPUT" | jq -c '.tool_input // {}' 2>/dev/null) || TOOL_INPUT="{}"
AGENT_TYPE=$(printf '%s' "$INPUT" | jq -r '.agent_type // empty' 2>/dev/null) || AGENT_TYPE=""

[ -n "$TOOL_NAME" ] || exit 0

# Normalize agent type to role name (strip plugin prefix if present)
ROLE=$(printf '%s' "$AGENT_TYPE" | sed 's|.*:||' | tr '[:upper:]' '[:lower:]')

# Builder has full access — no restrictions
[ "$ROLE" = "builder" ] && exit 0

# ── Vault path resolution ──────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# Source lib-common for VAULT_DIR — tolerate failure
source "${SCRIPT_DIR}/lib-common.sh" 2>/dev/null || true
VAULT="${VAULT_DIR:-${BRAINS_VAULT_DIR:-${HOME}/.hatbrains}}"

# ── Lane enforcement helper ────────────────────────────────────────────

deny() {
  local reason="$1"
  jq -nc --arg r "$reason" \
    '{decision:"block",reason:$r,systemMessage:$r}'
  exit 0
}

# ── Fail-CLOSED: deny restricted tools for unknown/empty roles ─────────
# If agent_type couldn't be parsed, don't fall through to allow-all.
if [ -z "$ROLE" ]; then
  case "$TOOL_NAME" in
    Write|Edit)
      FILE=$(printf '%s' "$TOOL_INPUT" | jq -r '.file_path // empty' 2>/dev/null) || FILE=""
      deny "enforce-teammate-lanes: agent_type unresolved (empty). Write/Edit blocked for unknown subagent. Attempted path: ${FILE:-<unknown>}."
      ;;
    Bash)
      CMD=$(printf '%s' "$TOOL_INPUT" | jq -r '.command // empty' 2>/dev/null) || CMD=""
      if printf '%s' "$CMD" | grep -qE 'git[[:space:]].*(commit|push|add|reset|checkout|merge|rebase)'; then
        deny "enforce-teammate-lanes: agent_type unresolved (empty). Destructive git command blocked for unknown subagent: $CMD."
      fi
      ;;
  esac
  exit 0
fi

case "$ROLE" in

  librarian)
    case "$TOOL_NAME" in
      Write|Edit)
        FILE=$(printf '%s' "$TOOL_INPUT" | jq -r '.file_path // empty' 2>/dev/null) || FILE=""
        # Fail CLOSED: if vault path is empty, deny rather than allow
        if [ -z "$VAULT" ]; then
          deny "Librarian lane: VAULT_DIR unresolved — Write blocked. Set BRAINS_VAULT_DIR or ensure lib-common.sh is reachable."
        fi
        # Allow writes only under the vault directory
        ABS_FILE=$(readlink -f "$FILE" 2>/dev/null || printf '%s' "$FILE")
        ABS_VAULT=$(readlink -f "$VAULT" 2>/dev/null || printf '%s' "$VAULT")
        if [ -n "$FILE" ] && ! printf '%s' "$ABS_FILE" | grep -q "^${ABS_VAULT}/"; then
          deny "Librarian lane violation: Write/Edit is only permitted under the vault ($VAULT). Attempted path: $FILE. Repo source writes must go through Builder."
        fi
        ;;
      Bash)
        CMD=$(printf '%s' "$TOOL_INPUT" | jq -r '.command // empty' 2>/dev/null) || CMD=""
        # Deny git destructive ops unless they target the vault.
        # Allow any of these forms:
        #   git -C "$VAULT_DIR" ...        (variable form, unresolved)
        #   git -C "$BRAINS_VAULT_DIR" ... (variable form, unresolved)
        #   git -C "<resolved-vault-path>" ... (literal resolved path)
        if printf '%s' "$CMD" | grep -qE 'git[[:space:]].*(commit|push|add|reset|checkout|merge|rebase)'; then
          if printf '%s' "$CMD" | grep -qF '$VAULT_DIR' \
              || printf '%s' "$CMD" | grep -qF '$BRAINS_VAULT_DIR' \
              || ( [ -n "$VAULT" ] && printf '%s' "$CMD" | grep -qF "$VAULT" ); then
            exit 0  # vault-scoped git op — allow
          fi
          deny "Librarian lane violation: git commit/push/add is only permitted on the vault repo. Commands must use git -C \"\$VAULT_DIR\" (or \$BRAINS_VAULT_DIR, or the resolved vault path). Detected: $CMD. Route repo-level git ops through Builder."
        fi
        ;;
    esac
    ;;

  critic|scout)
    case "$TOOL_NAME" in
      Write|Edit)
        FILE=$(printf '%s' "$TOOL_INPUT" | jq -r '.file_path // empty' 2>/dev/null) || FILE=""
        deny "${ROLE^} lane violation: Write/Edit is not permitted. ${ROLE^} is read-only. Attempted path: ${FILE:-<unknown>}. Route writes through Builder."
        ;;
      Bash)
        CMD=$(printf '%s' "$TOOL_INPUT" | jq -r '.command // empty' 2>/dev/null) || CMD=""
        # Deny destructive git ops (commit, push, reset --hard, checkout .)
        if printf '%s' "$CMD" | grep -qE 'git[[:space:]].*(commit|push|reset[[:space:]]+--hard|checkout[[:space:]]+\.)'; then
          deny "${ROLE^} lane violation: git commit/push is not permitted. ${ROLE^} has read-only repo access. Detected: $CMD. Route commits through Builder."
        fi
        ;;
    esac
    ;;

esac

# All other tools / roles: allow
exit 0
