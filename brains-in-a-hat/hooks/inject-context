#!/usr/bin/env bash
#
# inject-context — SubagentStart hook.
#
# When a teammate spawns, inject:
#   1. The last N user/assistant turns from the main-thread transcript
#      (so teammates aren't blind to what the user and team-lead just said).
#   2. A ROSTER block built from this session's implicit team config, so a
#      teammate knows who else is live and how to address them.
#   3. A pointer into harness-native project memory (MEMORY.md), which is
#      where per-repo learnings now live (no more <repoKey>--learnings.md
#      in the vault — that duplication is gone).
#   4. The vault's <projectGroup>--shared--learnings.md, if this repo
#      belongs to a group and the file exists (cross-repo context only;
#      never injected for the "_solo" sentinel group, since there's no
#      shared file to leak between unrelated ungrouped repos).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "${SCRIPT_DIR}/lib-common.sh"

INPUT=$(cat)
TRANSCRIPT=$(echo "$INPUT" | jq -r '.transcript_path // empty' 2>/dev/null) || TRANSCRIPT=""
SID=$(echo "$INPUT" | jq -r '.session_id // empty' 2>/dev/null) || SID=""

# How many recent transcript turns to slice (configurable later)
TURNS_TO_INJECT=${BRAINS_TRANSCRIPT_TURNS:-20}

# Resolve project keys + vault location
REPO_KEY=$(derive_project_key)
PROJECT_GROUP=$(derive_project_group)

# ── Build the transcript slice ────────────────────────────────────────────
# Filter FIRST (select matching records, one full JSON object per line via
# jq -c so embedded newlines in message text can't confuse a later `tail`),
# THEN take the last N matching records, THEN extract/format text. Doing it
# in this order (rather than `tail` on raw file lines) is what makes this
# "last N turns" instead of "last N raw JSONL records" — tool-call and
# isMeta records are excluded by the filter, not counted against N.
TRANSCRIPT_SLICE=""
if [ -n "$TRANSCRIPT" ] && [ -f "$TRANSCRIPT" ]; then
  TRANSCRIPT_SLICE=$(jq -c 'select(.type=="user" or .type=="assistant") | select(.isMeta != true)' "$TRANSCRIPT" 2>/dev/null \
    | tail -n "$TURNS_TO_INJECT" \
    | jq -r '
        .message.content as $c
        | (
            if ($c | type) == "string" then $c
            else ($c // [] | map(select(.type == "text") | .text) | join("\n"))
            end
          ) as $text
        | select($text != null and $text != "")
        | "[\(.type)] \($text)"
      ' 2>/dev/null \
    | head -c 8000) || TRANSCRIPT_SLICE=""
fi

# ── MEMORY.md index (harness-native per-repo memory) ──────────────────────
# cwd-slug convention: cwd with every "/" and "." replaced by "-" (the
# leading "/" becomes the leading "-" for free — no separate prefix step).
CWD_SLUG=$(pwd | sed 's/[\/.]/-/g')
MEMORY_INDEX="${HOME}/.claude/projects/${CWD_SLUG}/memory/MEMORY.md"
MEMORY_CONTENT=""
[ -f "$MEMORY_INDEX" ] && MEMORY_CONTENT=$(head -c 2000 "$MEMORY_INDEX") || true

# ── Shared cross-repo learnings (vault; group-scoped only) ────────────────
SHARED_CONTENT=""
if [ "$PROJECT_GROUP" != "_solo" ]; then
  SHARED_LEARNINGS="${VAULT_DIR}/${PROJECT_GROUP}--shared--learnings.md"
  [ -f "$SHARED_LEARNINGS" ] && SHARED_CONTENT=$(head -c 4000 "$SHARED_LEARNINGS") || true
fi

# ── ROSTER block from the session's implicit team config ─────────────────
# Team config lives at ~/.claude/teams/session-<first 8 hex of session_id>/
# config.json — there is no TeamCreate/team_name; the session IS the team.
ROSTER_BLOCK=""
if [ -n "$SID" ]; then
  SID8="${SID:0:8}"
  TEAM_CONFIG="${HOME}/.claude/teams/session-${SID8}/config.json"
  if [ -f "$TEAM_CONFIG" ]; then
    ROSTER_BLOCK=$(jq -r '
      "--- Team roster (session-'"${SID8}"') ---\n" +
      ( [ .members[]
          | select(.name != "team-lead")
          | "  " + .name + " (" + (.agentType // "unknown") + ")"
        ] | join("\n")
      ) + "\n\nMessaging conventions (CRITICAL — wrong names misroute or drop messages):\n  - Address the lead as exactly \"team-lead\" (not \"Neal\" — that name is never spawned as a teammate).\n  - Address peers by their exact name above (e.g. \"Dewey\", \"Ada\").\n  - SendMessage only RESUMES an already-spawned teammate; it does NOT spawn one. Messaging a name that is not yet a live member is blocked by a guard hook, which returns a spawn hint rather than silently dropping.\n  - Peer DMs are allowed for clarification (e.g. Marco→Dewey: \"do we have a cached result for X?\").\n  - State-changing actions (vault writes, repo commits, task ownership) stay in your own lane."
    ' "$TEAM_CONFIG" 2>/dev/null) || ROSTER_BLOCK=""
  fi
fi

# If nothing to inject, exit clean
if [ -z "$TRANSCRIPT_SLICE" ] && [ -z "$MEMORY_CONTENT" ] && [ -z "$SHARED_CONTENT" ] && [ -z "$ROSTER_BLOCK" ]; then
  exit 0
fi

# Build additionalContext as a sectioned text block
ADDITIONAL_CTX=$(cat <<EOF
=== MAIN THREAD CONTEXT ===
You are a teammate spawned by team-lead (Neal). The main thread between the
user and team-lead is the source of truth for current intent. Below is the
last ${TURNS_TO_INJECT} turns of that conversation, plus repo/group memory.

projectGroup: ${PROJECT_GROUP}
repoKey: ${REPO_KEY}

--- Main thread (last ${TURNS_TO_INJECT} turns) ---
${TRANSCRIPT_SLICE:-<no transcript available>}

--- Project memory index (MEMORY.md) ---
${MEMORY_CONTENT:-<none yet>}
(Full memories live as individual files alongside this index at ${HOME}/.claude/projects/${CWD_SLUG}/memory/ — this is just the index.)

--- <${PROJECT_GROUP}--shared--learnings.md> ---
${SHARED_CONTENT:-<none — either no shared file yet, or this repo is ungrouped (_solo)>}

${ROSTER_BLOCK:+${ROSTER_BLOCK}
}
=== END MAIN THREAD CONTEXT ===
EOF
)

# Emit as additionalContext on the SubagentStart event
jq -nc --arg ctx "$ADDITIONAL_CTX" \
  '{hookSpecificOutput:{hookEventName:"SubagentStart",additionalContext:$ctx}}'
