#!/usr/bin/env bash
#
# new-roster-bootstrap — UserPromptSubmit hook for the new 5-agent roster.
#
# On the first prompt of a session where .brains_in_a_hat/project.json has
# {"newRoster": true}, emit an additionalContext block instructing Neal to:
#   1. TeamCreate hatbrains-<repoKey> (idempotent)
#   2. Agent(subagent_type=brains-in-a-hat:librarian, name="Dewey", ...)
#   3. Agent(subagent_type=brains-in-a-hat:critic,    name="Ebert", ...)
#   4. Agent(subagent_type=brains-in-a-hat:scout,     name="Marco", ...)
#   5. Agent(subagent_type=brains-in-a-hat:architect, name="Wright", ...)
#   6. Adopt the new-roster operating mode (route by intent, not CODEOWNERS;
#      spawn Builders on-demand when implementation tasks arrive)
#
# After firing once per session, the hook writes
# .brains_in_a_hat/state/new-roster-bootstrapped.<SID> and no-ops on
# subsequent prompts.
#
# Bails (no-op) when:
#   - newRoster flag isn't set → falls through to existing /assemble flow
#   - already bootstrapped this session (marker exists)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "${SCRIPT_DIR}/lib-common.sh"

INPUT=$(cat)
SID=$(echo "$INPUT" | jq -r '.session_id // empty' 2>/dev/null) || SID=""

# Bail: no session id
[ -n "$SID" ] || exit 0

mkdir -p .brains_in_a_hat/state

# Check for a pending compaction recovery (set by PreCompact hook). If set,
# we still emit the bootstrap block — but with extra compaction-recovery
# instructions appended.
COMPACT_RECOVERING=false
for m in .brains_in_a_hat/state/compact-pending.*; do
  [ -f "$m" ] || continue
  if [ "${m##*/compact-pending.}" = "$SID" ]; then
    COMPACT_RECOVERING=true
    rm -f "$m"
    break
  fi
done

# Bail: already bootstrapped this session (unless we just detected a
# compaction event, which is reason to re-emit the orientation).
MARKER=".brains_in_a_hat/state/new-roster-bootstrapped.${SID}"
if [ -f "$MARKER" ] && [ "$COMPACT_RECOVERING" = "false" ]; then
  exit 0
fi
touch "$MARKER"

# Set active marker so other hooks know team is active
echo "active" > ".brains_in_a_hat/state/active.${SID}"

REPO_KEY=$(derive_project_key)
PROJECT_GROUP=$(derive_project_group)
TEAM_NAME="hatbrains-${REPO_KEY}"

read -r -d '' INSTRUCTION <<EOF || true
NEW-ROSTER BOOTSTRAP (newRoster=true detected in .brains_in_a_hat/project.json):

This session uses the v1.0.0-alpha roster — not the legacy 21-agent team.
Your roster (Neal + singletons + on-demand Builders):
  - Neal (you, main thread) — orchestrator + meta-analysis (friction patterns, improvement suggestions)
  - Dewey (librarian) — always-on storage/retrieval/curation; owns vault git ops
  - Ebert (critic) — on-demand reviewer with lens param (architecture|security|performance|ux|correctness)
  - Marco (scout) — on-demand research with explicit retrieval routing
  - Wright (architect) — on-demand design blueprints + architecture audits; read-only; returns blueprint via SendMessage; Builder implements
  - Builders (on-demand, spawn when needed): Ada=ML, Grace=infra, Shannon=sci/math/signal; all subagent_type=builder; cap 3 concurrent

Routing is by intent, NOT by file path (no CODEOWNERS).

Spawn the 4 singletons now (one-shot, fire-and-exit, run_in_background=true):

  TeamCreate(team_name="${TEAM_NAME}")

  Agent(
    subagent_type="brains-in-a-hat:librarian",
    name="Dewey",
    team_name="${TEAM_NAME}",
    mode="bypassPermissions",
    run_in_background=true,
    prompt="Initial spawn. Pull the vault, load ${REPO_KEY}--learnings.md and ${PROJECT_GROUP}--shared--learnings.md, then idle until the librarian-tick hook re-engages you. Project: projectGroup=${PROJECT_GROUP}, repoKey=${REPO_KEY}, vault=\$BRAINS_VAULT_DIR."
  )

  Agent(
    subagent_type="brains-in-a-hat:critic",
    name="Ebert",
    team_name="${TEAM_NAME}",
    mode="bypassPermissions",
    run_in_background=true,
    prompt="Initial spawn on team '${TEAM_NAME}'. Read your persona from brains-in-a-hat/agents/critic.md. You are Ebert. Idle until Neal routes a review task to you via SendMessage."
  )

  Agent(
    subagent_type="brains-in-a-hat:scout",
    name="Marco",
    team_name="${TEAM_NAME}",
    mode="bypassPermissions",
    run_in_background=true,
    prompt="Initial spawn on team '${TEAM_NAME}'. Read your persona from brains-in-a-hat/agents/scout.md. You are Marco. Idle until Neal routes a research task to you via SendMessage."
  )

  Agent(
    subagent_type="brains-in-a-hat:architect",
    name="Wright",
    team_name="${TEAM_NAME}",
    mode="bypassPermissions",
    run_in_background=true,
    prompt="Initial spawn on team '${TEAM_NAME}'. Read your persona from brains-in-a-hat/agents/architect.md. You are Wright. Idle until Neal routes a design or blueprint task to you via SendMessage."
  )

Builders (Ada/Grace/Shannon) are NOT pre-spawned. Spawn them lazily via Agent + SendMessage when an implementation task arrives. Pick the best-fit domain (Ada=ML, Grace=infra, Shannon=sci/math/signal). Cap: 3 concurrent.

Vault state: \$BRAINS_VAULT_DIR (must be a git repo). projectGroup=${PROJECT_GROUP}, repoKey=${REPO_KEY}.

When you reply to the user, briefly acknowledge the team is online. Don't list all teammates — that's noise. Just proceed with the user's request.
EOF

if [ "$COMPACT_RECOVERING" = "true" ]; then
  INSTRUCTION="${INSTRUCTION}

COMPACTION RECOVERY: this session just resumed after a compaction. Your spawned teammates and any in-flight work may have been compressed away. Re-spawn the 4 singletons per the block above (Dewey/Ebert/Marco/Wright). Ask Dewey for the latest <repoKey>--learnings.md and the most recent entries in <projectGroup>--session-log.md to re-orient."
fi

jq -nc --arg ctx "$INSTRUCTION" \
  '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:$ctx}}'
