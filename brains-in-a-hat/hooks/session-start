#!/usr/bin/env bash
#
# session-start — SessionStart hook for brains-in-a-hat (v1.0.0-alpha onward)
#
# Minimal:
#   - Bootstrap .brains_in_a_hat/state/ directory.
#   - Clean stale per-session markers from previous sessions.
#   - On compact-source sessions, write compact-pending marker so the next
#     UserPromptSubmit can emit a recovery hint via new-roster-bootstrap.
#
# Does NOT inject persona, gather context, create CODEOWNERS, set up
# vault-templates, or migrate legacy state. The new roster handles
# orientation via new-roster-bootstrap on the first user prompt; the vault
# is the user's own private git repo set up via scripts/vault-init.sh.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "${SCRIPT_DIR}/lib-common.sh"

STATE_DIR=".brains_in_a_hat/state"

INPUT=$(cat)
SOURCE=$(echo "$INPUT" | jq -r '.source // empty' 2>/dev/null) || SOURCE=""
SID=$(echo "$INPUT" | jq -r '.session_id // empty' 2>/dev/null) || SID=""

mkdir -p "$STATE_DIR"

# Clean per-session markers that aren't ours (stale from previous runs).
# Pattern: <name>.<SID> where SID is encoded in filename.
for marker in "$STATE_DIR"/active.* \
              "$STATE_DIR"/new-roster-bootstrapped.* \
              "$STATE_DIR"/in-subagent.* \
              "$STATE_DIR"/librarian-cursor.*; do
  [ -f "$marker" ] || continue
  marker_sid="${marker##*.}"
  if [ "$marker_sid" != "$SID" ]; then
    # Don't reap active.<SID> from another concurrent live session; check pid liveness.
    if [[ "$marker" == */active.* ]]; then
      kill -0 "$marker_sid" 2>/dev/null || rm -f "$marker"
    else
      rm -f "$marker"
    fi
  fi
done

# Stale compact-pending markers from other sessions
for marker in "$STATE_DIR"/compact-pending.*; do
  [ -f "$marker" ] || continue
  [ "${marker##*/compact-pending.}" = "$SID" ] || rm -f "$marker"
done

# If we're resuming from a compaction, mark this session for recovery
if [ "$SOURCE" = "compact" ] && [ -n "$SID" ]; then
  touch "${STATE_DIR}/compact-pending.${SID}"
fi

# No output — the new-roster-bootstrap hook handles orientation on the
# first user prompt of the session.
