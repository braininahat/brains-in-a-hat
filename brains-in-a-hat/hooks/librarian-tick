#!/usr/bin/env bash
#
# librarian-tick — TeammateIdle hook for Dewey (Librarian).
#
# Fires when ANY teammate is about to go idle. We filter for Dewey (the
# only teammate this hook re-engages) and, when there's work to do,
# re-engage via the sanctioned TeammateIdle mechanism: print the TICK
# prompt to STDERR and exit 2. (An earlier version emitted
# {"continue":false,...} JSON on stdout with exit 0 — that's undocumented
# and does not work; exit 2 + stderr is the only sanctioned re-engage, and
# the whole hook must finish well under the 5s timeout.)
#
# Bails (plain exit 0, no output) when:
#   - the vault isn't a git repo (nothing for Dewey to do at all)
#   - the idling teammate isn't Dewey
#   - no transcript path / transcript not readable
#   - no outstanding receipt to resolve, no new turns anywhere, no sweep hit
#
# IMPORTANT — hooks.json's TeammateIdle entry does NOT redirect this script's
# stderr anywhere (unlike every other hook). That's deliberate: the harness
# reads the TICK/RETRY prompt FROM stderr on an exit-2 re-engage, so
# redirecting it into hook-debug.log (as an earlier version did) silently
# swallows the prompt — Dewey gets re-engaged with no instructions. The
# invariant this imposes: nothing may write to stderr in this script except
# `reengage()`. Any internal debug/trace output (e.g. on the exit-0
# escalation path) must append to `${STATE_DIR}/hook-debug.log` by explicit
# path instead of using `>&2`.
#
# State keying: cursor/pending/noop files are keyed by a hash of the
# TRANSCRIPT PATH (not session id), so they survive across sessions/resumes
# — a later session reading a different transcript file can still confirm
# a prior tick or sweep up turns that were never curated. Each cursor file
# stores the cursor value on line 1 and the transcript path on line 2, so a
# sweep can find and re-open it without any other index.
#
#   Cursor:      state/librarian-cursor.<THASH>       "<line>\n<transcript>"
#   Pending:     state/librarian-pending.<THASH>       PRE_HEAD=...\nPROPOSED_CURSOR=...\nPROPOSED_TRANSCRIPT=...\nRETRY=...
#   Noop:        state/librarian-noop.<THASH>          (empty; existence is the receipt)
#   Escalation:  state/librarian-escalation.<THASH>    (free text; surfaced + deleted by new-roster-bootstrap)
#
# Receipt model (advance-only-on-confirmed-work):
#   A pending sidecar is written BEFORE re-engaging Dewey, recording the
#   vault HEAD at fire time and the cursor value Dewey is being asked to
#   reach. On the NEXT idle, we check for a receipt:
#     - vault HEAD advanced since PRE_HEAD           → confirmed, promote
#     - state/librarian-noop.<THASH> exists          → confirmed, promote
#     - neither                                       → retry (bounded)
#   This replaces the old "every tick MUST commit, even if empty" rule —
#   Dewey may now genuinely report nothing to record without vault churn.
#   After MAX_RETRIES consecutive unconfirmed ticks, we stop re-engaging,
#   advance the cursor anyway (accept the loss so we don't retry forever),
#   and write an escalation file for new-roster-bootstrap to surface.
#
# Sweep (tail-of-session fix): if the CURRENT transcript has nothing new,
# look across all librarian-cursor.* files for one whose recorded
# transcript path still exists and has more lines than its cursor — this
# picks up a prior session's post-last-tick turns, which would otherwise
# never be revisited (the next session reads a different transcript file).
# At most one sweep target per invocation.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# Guarded source (#57 polish): a broken/missing lib shouldn't crash this
# hook (it must always finish, well under the 5s TeammateIdle timeout).
source "${SCRIPT_DIR}/lib-research.sh" 2>/dev/null || true
: "${VAULT_DIR:=${BRAINS_VAULT_DIR:-${HOME}/.hatbrains}}"

MAX_RETRIES=3
STATE_DIR=".brains_in_a_hat/state"

# Track every tmpfile we create so a trap can clean them up on any exit
# path (including the reengage exit 2) instead of scattering manual `rm -f`.
TMPFILES=()
_cleanup_tmpfiles() {
  local f
  for f in "${TMPFILES[@]:-}"; do
    [ -n "$f" ] && rm -f "$f"
  done
  return 0   # a trap's own exit status overrides the real `exit N` otherwise
}
trap _cleanup_tmpfiles EXIT

# Sets the variable NAMED in $1 to a fresh tmpfile path. Must be called as
# `_mktemp_tracked VARNAME`, never `VAR=$(_mktemp_tracked)` — the latter runs
# the function in a subshell, so its TMPFILES+=() append is invisible to the
# parent shell and nothing gets cleaned up.
_mktemp_tracked() {
  local __outvar="$1"
  local f
  f=$(mktemp)
  TMPFILES+=("$f")
  printf -v "$__outvar" '%s' "$f"
}

# Print $1 (a file containing the TICK prompt) to stderr and exit 2 — the
# only sanctioned TeammateIdle re-engage signal.
reengage() {
  cat "$1" >&2
  exit 2
}

write_pending() {
  # $1=file $2=pre_head $3=cursor $4=transcript $5=retry
  printf 'PRE_HEAD=%s\nPROPOSED_CURSOR=%s\nPROPOSED_TRANSCRIPT=%s\nRETRY=%s\n' \
    "$2" "$3" "$4" "$5" > "$1"
}

write_cursor() {
  # $1=file $2=cursor $3=transcript
  printf '%s\n%s\n' "$2" "$3" > "$1"
}

cursor_value() {
  [ -f "$1" ] && sed -n '1p' "$1" 2>/dev/null || true
}

cursor_transcript() {
  [ -f "$1" ] && sed -n '2p' "$1" 2>/dev/null || true
}

# git rev-parse HEAD on a repo with zero commits prints the literal string
# "HEAD" to STDOUT (its best-effort echo of the unresolved token) while
# failing on stderr with exit 128 — `2>/dev/null || true` alone captures
# that garbage instead of empty. Only trust stdout when the command
# actually succeeded.
vault_head() {
  local h
  h=$(git -C "$VAULT_DIR" rev-parse HEAD 2>/dev/null) || h=""
  printf '%s' "$h"
}

# ── Bail early, before anything else: vault must be a git repo ───────────
vault_is_git_repo || exit 0

# ── Read hook input ────────────────────────────────────────────────────
INPUT=$(cat)
AGENT_NAME=$(echo "$INPUT" | jq -r '.agent_name // empty' 2>/dev/null) || AGENT_NAME=""
TRANSCRIPT=$(echo "$INPUT" | jq -r '.transcript_path // empty' 2>/dev/null) || TRANSCRIPT=""

# Bail: not Dewey (Librarian) → exit 0 silently (let teammate idle normally)
[ "$AGENT_NAME" = "Dewey" ] || exit 0

# Bail: no transcript path → can't process
[ -n "$TRANSCRIPT" ] && [ -f "$TRANSCRIPT" ] || exit 0

mkdir -p "$STATE_DIR" 2>/dev/null || true

# ── Resolve any outstanding pending receipts ──────────────────────────────
# In steady state there's at most one librarian-pending.* file (we never
# propose new work while one is outstanding — see below), but this loop
# tolerates more defensively. The first one that needs a retry or hits the
# escalation ceiling ends the script (reengage exits 2; escalation exits 0).
for PENDING_FILE in "$STATE_DIR"/librarian-pending.*; do
  [ -f "$PENDING_FILE" ] || continue
  P_THASH="${PENDING_FILE##*/librarian-pending.}"
  CURSOR_FILE="${STATE_DIR}/librarian-cursor.${P_THASH}"
  NOOP_FILE="${STATE_DIR}/librarian-noop.${P_THASH}"

  PRE_HEAD=""
  PROPOSED_CURSOR=""
  PROPOSED_TRANSCRIPT=""
  RETRY=0
  while IFS='=' read -r key val; do
    case "$key" in
      PRE_HEAD)             PRE_HEAD="$val" ;;
      PROPOSED_CURSOR)       PROPOSED_CURSOR="$val" ;;
      PROPOSED_TRANSCRIPT)   PROPOSED_TRANSCRIPT="$val" ;;
      RETRY)                 RETRY="$val" ;;
    esac
  done < "$PENDING_FILE"

  CURRENT_HEAD=$(vault_head)

  CONFIRMED=false
  if [ -z "$PRE_HEAD" ]; then
    # First tick ever against a fresh vault (no commits at snapshot time) —
    # HEAD-advance detection has nothing to advance FROM, so confirm on
    # either a commit now existing or an explicit noop receipt.
    if [ -n "$CURRENT_HEAD" ] || [ -f "$NOOP_FILE" ]; then
      CONFIRMED=true
    fi
  else
    if [ -n "$CURRENT_HEAD" ] && [ "$CURRENT_HEAD" != "$PRE_HEAD" ]; then
      CONFIRMED=true
    elif [ -f "$NOOP_FILE" ]; then
      CONFIRMED=true
    fi
  fi

  if [ "$CONFIRMED" = "true" ]; then
    write_cursor "$CURSOR_FILE" "$PROPOSED_CURSOR" "$PROPOSED_TRANSCRIPT"
    rm -f "$PENDING_FILE" "$NOOP_FILE"
    continue
  fi

  # Not confirmed.
  RETRY=$((RETRY + 1))
  if [ "$RETRY" -ge "$MAX_RETRIES" ]; then
    # Escalate WITHOUT re-engaging Dewey (issue #57 C2): advance the cursor
    # anyway (accept the loss so this doesn't retry forever), surface to
    # team-lead via new-roster-bootstrap on the next prompt, and let Dewey
    # stay idle.
    write_cursor "$CURSOR_FILE" "$PROPOSED_CURSOR" "$PROPOSED_TRANSCRIPT"
    rm -f "$PENDING_FILE" "$NOOP_FILE"
    cat > "${STATE_DIR}/librarian-escalation.${P_THASH}" <<ESCEOF
ESCALATION: Dewey (Librarian) failed to confirm a vault write after ${MAX_RETRIES} consecutive ticks. Lines are being skipped in ${PROPOSED_TRANSCRIPT} to prevent an infinite retry loop — they will NOT be re-processed (cursor advanced to ${PROPOSED_CURSOR}). Vault HEAD has not advanced from ${PRE_HEAD:-<no commits yet>}. Inspect Dewey's last output and the vault at ${VAULT_DIR} — it may be unreachable or have a conflict that needs manual resolution.
ESCEOF
    # Debug trail only — goes straight to the log file by explicit path, not
    # stderr. This path exits 0 (no re-engage), but stderr is unredirected at
    # the hooks.json level for this hook (so exit-2 TICK prompts reach the
    # harness cleanly); any stray stderr output here would leak right past
    # that, so nothing but a reengage() prompt may ever go to stderr.
    echo "$(date -Iseconds 2>/dev/null || date) librarian-tick: escalated after ${MAX_RETRIES} retries (thash=${P_THASH})" >> "${STATE_DIR}/hook-debug.log" 2>/dev/null || true
    exit 0
  fi

  write_pending "$PENDING_FILE" "$PRE_HEAD" "$PROPOSED_CURSOR" "$PROPOSED_TRANSCRIPT" "$RETRY"
  RETRY_CURSOR=$(cursor_value "$CURSOR_FILE")
  [ -n "$RETRY_CURSOR" ] || RETRY_CURSOR=0
  NEW_TURNS=$((PROPOSED_CURSOR - RETRY_CURSOR))
  _mktemp_tracked RETRY_TMP
  cat > "$RETRY_TMP" <<RETRYEOF
TICK (retry ${RETRY}/${MAX_RETRIES}): Your previous tick did not produce a confirmed receipt (vault HEAD ${PRE_HEAD:-<no commits yet>} unchanged, and no noop file). Re-processing ${NEW_TURNS} transcript lines (${RETRY_CURSOR}..${PROPOSED_CURSOR}) of ${PROPOSED_TRANSCRIPT}.

Run your standard idle-tick procedure:
  1. git -C "\$VAULT_DIR" pull --rebase --autostash (warn team-lead if it fails; continue with local).
  2. Read lines ${RETRY_CURSOR}-${PROPOSED_CURSOR} of ${PROPOSED_TRANSCRIPT}.
  3. Classify each meaningful turn (skip noise per your persona).
  4. For each candidate fact, run curation: update / append / supersede / drop.
  5. If you made any vault writes: git -C "\$VAULT_DIR" add -A && git -C "\$VAULT_DIR" commit -m "<brief description>" && git -C "\$VAULT_DIR" push. Then SendMessage team-lead: "Tick SHA: <full commit SHA>. Processed N turns, M vault writes."
  6. If there is genuinely nothing to record: do NOT commit. Instead run: touch "${NOOP_FILE}"
     Then SendMessage team-lead: "Tick: NOOP, ${NEW_TURNS} turns scanned."
Omitting both the commit/SHA report and the noop touch will trigger another retry on the next idle.

Stay alive; you'll be re-engaged on the next idle.
RETRYEOF
  reengage "$RETRY_TMP"
done

# ── Decide what the next tick should be about ─────────────────────────────
# Prefer the current session's own transcript. If it has nothing new,
# sweep for another transcript with unprocessed lines (tail-of-session fix).
CUR_THASH=$(cache_shorthash "$(_sha256 "$TRANSCRIPT")")
CUR_CURSOR_FILE="${STATE_DIR}/librarian-cursor.${CUR_THASH}"
CUR_CURSOR=$(cursor_value "$CUR_CURSOR_FILE")
[ -n "$CUR_CURSOR" ] || CUR_CURSOR=0
CUR_TOTAL=$(wc -l < "$TRANSCRIPT" 2>/dev/null || echo 0)

TARGET_THASH="$CUR_THASH"
TARGET_TRANSCRIPT="$TRANSCRIPT"
TARGET_CURSOR="$CUR_CURSOR"
TARGET_TOTAL="$CUR_TOTAL"

if [ "$TARGET_TOTAL" -le "$TARGET_CURSOR" ]; then
  SWEPT=""
  for cf in $(ls -t "$STATE_DIR"/librarian-cursor.* 2>/dev/null); do
    [ -f "$cf" ] || continue
    SW_THASH="${cf##*/librarian-cursor.}"
    [ "$SW_THASH" != "$CUR_THASH" ] || continue
    SW_CURSOR=$(cursor_value "$cf")
    [ -n "$SW_CURSOR" ] || SW_CURSOR=0
    SW_TRANSCRIPT=$(cursor_transcript "$cf")
    [ -n "$SW_TRANSCRIPT" ] && [ -f "$SW_TRANSCRIPT" ] || continue
    SW_TOTAL=$(wc -l < "$SW_TRANSCRIPT" 2>/dev/null || echo 0)
    if [ "$SW_TOTAL" -gt "$SW_CURSOR" ]; then
      SWEPT="$SW_THASH"
      TARGET_THASH="$SW_THASH"
      TARGET_TRANSCRIPT="$SW_TRANSCRIPT"
      TARGET_CURSOR="$SW_CURSOR"
      TARGET_TOTAL="$SW_TOTAL"
      break   # at most one sweep target per tick
    fi
  done
  [ -n "$SWEPT" ] || exit 0   # nothing new anywhere
fi

NEW_TURNS=$((TARGET_TOTAL - TARGET_CURSOR))
PENDING_FILE="${STATE_DIR}/librarian-pending.${TARGET_THASH}"
NOOP_FILE="${STATE_DIR}/librarian-noop.${TARGET_THASH}"

# RECORD-REQUEST fast path: if the new slice contains a literal
# RECORD-REQUEST: token (placed there by team-lead via SendMessage),
# prepend a hard directive so Dewey cannot classify it as noise.
RECORD_REQUEST_PREFIX=""
if tail -n +"$((TARGET_CURSOR + 1))" "$TARGET_TRANSCRIPT" 2>/dev/null | grep -qF 'RECORD-REQUEST:'; then
  RECORD_REQUEST_PREFIX="EXPLICIT RECORD REQUEST detected in this slice — you MUST write and commit it; do not classify as noise. Treat every RECORD-REQUEST: line as a mandatory vault write.

"
fi

# Snapshot vault HEAD before re-engaging Dewey
PRE_HEAD=$(vault_head)

# Write the pending sidecar BEFORE emitting the prompt, so the next tick can
# verify what actually happened.
write_pending "$PENDING_FILE" "$PRE_HEAD" "$TARGET_TOTAL" "$TARGET_TRANSCRIPT" "0"

_mktemp_tracked TICK_TMP
cat > "$TICK_TMP" <<TICKEOF
${RECORD_REQUEST_PREFIX}TICK: ${NEW_TURNS} new transcript lines since your last cursor (${TARGET_CURSOR}..${TARGET_TOTAL}) of ${TARGET_TRANSCRIPT}.

Run your standard idle-tick procedure:
  1. git -C "\$VAULT_DIR" pull --rebase --autostash (warn team-lead if it fails; continue with local).
  2. Read lines ${TARGET_CURSOR}-${TARGET_TOTAL} of ${TARGET_TRANSCRIPT}.
  3. Classify each meaningful turn (skip noise per your persona).
  4. For each candidate fact, run curation: update / append / supersede / drop.
  5. If you made any vault writes: git -C "\$VAULT_DIR" add -A && git -C "\$VAULT_DIR" commit -m "<brief description>" && git -C "\$VAULT_DIR" push. Then SendMessage team-lead: "Tick SHA: <full commit SHA>. Processed N turns, M vault writes."
  6. If there is genuinely nothing to record: do NOT commit. Instead run: touch "${NOOP_FILE}"
     Then SendMessage team-lead: "Tick: NOOP, ${NEW_TURNS} turns scanned."
Omitting both the commit/SHA report and the noop touch will trigger a retry on the next idle.

Stay alive; you'll be re-engaged on the next idle.
TICKEOF

reengage "$TICK_TMP"
